# Replace gateway.example.com with your dedicated hostname; existing washer site stays separate.
# Obtain the matching certificate before enabling this 443 server block.
server {
    listen 80;
    server_name gateway.example.com;
    location /.well-known/acme-challenge/ { root /var/www/gateway-acme; }
    location / { return 301 https://gateway.example.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name gateway.example.com;
    ssl_certificate /etc/letsencrypt/live/gateway.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gateway.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8k;
    location /gateway/ws {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 65s;
    }
    location / {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
